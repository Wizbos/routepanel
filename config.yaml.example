# /opt/routepanel/config.yaml.example
bind_host: "127.0.0.1"
port: 8080
db_path: "/etc/routepanel/db.sqlite"
ipsets_save_path: "/etc/routepanel/ipsets.save"
poll_interval: 300
health_interval: 30
health_latency_threshold_ms: 200.0
health_down_threshold: 3
health_up_threshold: 3
failback_min_dwell_sec: 300
default_exit_id: ""
client_interfaces:
  - awg0
frr_next_hop: ""   # NOT Null0: Null0 blackholes any direct-exit (or failover-to-direct) traffic in the main table
wan_interface: "eth0"

# DNS interception (hybrid model — §3.5). false = periodic resolution only.
dns_intercept: true
dnsmasq_conf_path: "/etc/routepanel/dnsmasq-routepanel.conf"
dnsmasq_service: "dnsmasq"          # systemctl reload <service> after regen

# OSPF rate-limiting (§8.1)
ospf_debounce_sec: 60
max_ospf_ips_per_rule: 64

# Housekeeping
resolved_ip_ttl_days: 7
ipset_timeout_sec: 86400   # ipset members auto-expire after this (dnsmasq + daemon both add without explicit timeout)

resolver_address: "127.0.0.1"
resolver_port: 5353

# Auth: absent password_file = auth disabled (installer always creates it)
password_file: "/etc/routepanel/panel.passwd"

# Exit tunnel imports (rpx<N>.conf) and the client-facing AWG server config
exit_conf_dir: "/etc/routepanel/exits"
awg_conf_path: "/etc/amnezia/amneziawg/awg0.conf"
awg_interface: "awg0"
